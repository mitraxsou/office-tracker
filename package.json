{
  "name": "office-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-postgres-env.mjs -- next dev",
    "dev:prod": "node scripts/run-with-env-profile.mjs prod -- node scripts/ensure-postgres-env.mjs -- next dev",
    "env:pull:dev": "node scripts/pull-hobby-env.mjs dev",
    "env:pull:prod": "node scripts/pull-hobby-env.mjs prod",
    "build": "node scripts/ensure-postgres-env.mjs --generate-only -- prisma generate && node scripts/setup-db-on-deploy.mjs && node scripts/ensure-postgres-env.mjs -- next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:regression": "vitest run tests/agent-heartbeat-sync.test.ts tests/agent-storage.test.ts tests/agent-version.test.ts tests/agent-sync.test.ts tests/agent-ps51-compat.test.ts tests/heartbeat-eod.test.ts tests/activity-signal.test.ts tests/agent-api-hits.test.ts",
    "regression:create-prod": "node scripts/regression/create-regression-user-prod.mjs",
    "test:watch": "vitest",
    "db:generate": "node scripts/ensure-postgres-env.mjs --generate-only -- prisma generate",
    "db:push": "node scripts/ensure-postgres-env.mjs -- prisma db push",
    "db:seed": "node scripts/ensure-postgres-env.mjs -- tsx prisma/seed.ts",
    "prisma:env": "node scripts/prisma-with-env.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "next": "^15.5.24",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.24",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
