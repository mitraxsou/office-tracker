# Docker Postgres profile (fully offline local DB).
# Copy to .env.docker.local, then:
#   docker compose -f docker-compose.dev.yml up -d
#   OFFICETRACKER_ENV_PROFILE=docker npm run db:push
#   OFFICETRACKER_ENV_PROFILE=docker npm run seed:demo

POSTGRES_PRISMA_URL=postgresql://office:office@localhost:5432/office_tracker?schema=public
POSTGRES_URL_NON_POOLING=postgresql://office:office@localhost:5432/office_tracker?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEV_SIMULATOR_ENABLED=1
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BREAKGLASS_EMAIL=admin@pwc.office
BREAKGLASS_PASSWORD=change-me-before-production
