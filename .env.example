# Database
# Local dev (SQLite):  DATABASE_URL="file:./prisma/dev.db"
# Vercel prod (Neon):  DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# For Neon on Vercel, change prisma/schema.prisma provider to "postgresql"
DATABASE_URL="file:./prisma/dev.db"

# Auth secret for session cookies (generate with: openssl rand -base64 32)
# Must be at least 32 characters
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public app URL (local dev or Vercel deployment URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default office Wi-Fi SSIDs seeded on registration (both count as in-office)
DEFAULT_OFFICE_SSIDS="OfficeConnect,ExternalConnect"

# Email of the user to promote to admin on seed (optional; breakglass admin always created)
ADMIN_EMAIL=""

# Full path to agent folder for local dev install commands (optional)
AGENT_INSTALL_PATH=""
