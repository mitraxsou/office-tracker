# =============================================================================
# Local development
# =============================================================================
# Use Neon Postgres (free tier) for local dev, or a local Postgres instance.
# SQLite is not supported — production uses PostgreSQL on Vercel/Neon.
#
# Option A — Vercel Storage var names (matches production):
# POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true"
# POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
#
# Option B — legacy single URL (copied to POSTGRES_* by resolve-postgres-env):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
#
# Misconfigured Vercel Storage prefix (auto-detected; fix prefix in dashboard — see README):
# DATABASE_URL_POSTGRES_URL / DATABASE_URL_DATABASE_URL / DATABASE_URL_UNPOOLED

# Auth secret for session cookies (generate: openssl rand -base64 32)
# Must be at least 32 characters
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public app URL — set to your Vercel URL in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default office Wi-Fi SSIDs (seeded into AppConfig)
DEFAULT_OFFICE_SSIDS="OfficeConnect,ExternalConnect,pwcglb.com"

# Default heartbeat interval for a newly created AppConfig only (2-60 minutes)
DEFAULT_HEARTBEAT_INTERVAL_MINUTES="5"

# First month Office Pulse was active (YYYY-MM). Months before this count as compliant for year tracking.
PILOT_START_MONTH="2026-09"

# Optional: promote an existing user to admin on seed
ADMIN_EMAIL=""

# Breakglass admin — created on startup (instrumentation) and seed when both are set
BREAKGLASS_EMAIL="admin@pwc.office"
BREAKGLASS_PASSWORD="change-me-before-production"

# Set to "false" to disable the legacy /register password page (OTP self-registration is separate)
ALLOW_REGISTRATION="true"

# Optional: full path to agent folder for local dev install commands only (not needed on Vercel)
AGENT_INSTALL_PATH=""

# Cron (Vercel Cron or external): GET /api/cron/agent-alerts with Authorization: Bearer $CRON_SECRET
# CRON_SECRET="generate-a-long-random-string"

# Power Automate HTTP trigger URL. Treat the URL as a secret.
POWER_AUTOMATE_WEBHOOK_URL=""
# Shared header secret for X-Office-Pulse-Token (required for OTP and Teams notifications).
# Set on both Vercel projects (dev and prod). Independent of AUTH_SECRET rotation.
POWER_AUTOMATE_WEBHOOK_SECRET=""
# See docs/power-automate.md for flow setup.
