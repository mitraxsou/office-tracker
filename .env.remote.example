# Remote API profile for PwC VPN (Neon blocked locally).
# Copy to .env.remote.local and run: npm run dev:remote
#
# Use the deployed dev portal for dashboards. Localhost runs the simulator only.

OFFICETRACKER_REMOTE_API=1
OFFICETRACKER_REMOTE_API_URL=https://office-tracker-dev.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEV_SIMULATOR_ENABLED=1

# Session auth still needs a secret for local pages (breakglass login is optional).
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: Vercel Deployment Protection bypass when dev project is protected.
# VERCEL_AUTOMATION_BYPASS_SECRET=""
