# =============================================================================
# Production Neon Postgres — paste from Vercel dashboard (do not commit real values)
# =============================================================================
#
# Option A — Vercel Storage → Postgres → .env.local tab (recommended)
#   Copy the two lines Vercel shows for POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING.
#
# Option B — Vercel project → Settings → Environment Variables
#   Copy values for Production (or all environments):
#   POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING
#
# Save this file as .env.vercel.local in the project root, then run:
#   .\scripts\setup-prod-db.ps1
#
# If `npx vercel env pull` fails with invalid --token, clear the bad session var:
#   Remove-Item Env:VERCEL_TOKEN -ErrorAction SilentlyContinue
# then retry pull, or use manual copy above.

POSTGRES_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional seed default for new databases; admins can change the stored value later
DEFAULT_HEARTBEAT_INTERVAL_MINUTES="5"

# Optional — only needed if you also want breakglass admin seeded locally against prod:
# BREAKGLASS_EMAIL="admin@pwc.office"
# BREAKGLASS_PASSWORD="your-secure-password"
