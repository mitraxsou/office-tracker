generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model LoginOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuthRateLimitEvent {
  id        String   @id @default(cuid())
  bucket    String
  key       String
  createdAt DateTime @default(now())

  @@index([bucket, key, createdAt])
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String
  name               String?
  registrationSource String        @default("admin")
  role               String        @default("user")
  timezone           String        @default("Asia/Kolkata")
  hoursTarget        Float?
  agentStaleGraceHours Int?
  agentDeregisteredAt  DateTime?
  mustChangePassword Boolean       @default(false)
  passwordChosenAt   DateTime?
  passwordResetAt    DateTime?
  termsAcceptedAt      DateTime?
  termsAcceptedVersion Int?
  priorComplianceOnboardingAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  agentTokens  AgentToken[]
  agentDevices AgentDevice[]
  heartbeats   Heartbeat[]
  visits       Visit[]
  visitCorrectionRequests VisitCorrectionRequest[]
  resolvedVisitReports    VisitCorrectionRequest[] @relation("VisitReportResolver")
  visitCorrectionMessages VisitCorrectionMessage[]
  auditActions AuditLog[]    @relation("AuditActor")
  auditTargets AuditLog[]    @relation("AuditTarget")
  notificationPrefs UserNotificationPrefs?
  inAppNotifications InAppNotification[]
  integrationApiKeys IntegrationApiKey[]
  outOfOfficeDays    UserOutOfOffice[]
  deviceRemovalRequests DeviceRemovalRequest[]
  resolvedDeviceRemovals DeviceRemovalRequest[] @relation("DeviceRemovalResolver")
  timezoneChangeRequests TimezoneChangeRequest[]
  reviewedTimezoneRequests TimezoneChangeRequest[] @relation("TimezoneRequestReviewer")
  profileChangeRequests ProfileChangeRequest[]
  reviewedProfileChangeRequests ProfileChangeRequest[] @relation("ProfileChangeReviewer")
  complianceExemptionRequests ComplianceExemptionRequest[]
  reviewedComplianceExemptionRequests ComplianceExemptionRequest[] @relation("ComplianceExemptionReviewer")
  adminContactSubmissions AdminContactSubmission[]
  reviewedAdminContactSubmissions AdminContactSubmission[] @relation("AdminContactReviewer")
  adminContactMessages AdminContactMessage[]
  priorComplianceDeclarations PriorComplianceDeclaration[]
  reviewedPriorComplianceDeclarations PriorComplianceDeclaration[] @relation("PriorComplianceReviewer")
  agentLifecycleEvents AgentLifecycleEvent[]
}

model UserOutOfOffice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate String
  endDate   String
  source    String   @default("settings")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, startDate])
}

model IntegrationApiKey {
  id          String    @id @default(cuid())
  label       String
  keyPrefix   String    @unique
  keyHash     String
  encryptedSecret String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  @@index([createdById])
}

model UserNotificationPrefs {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDays              String   @default("[3,5]")
  officeStartTime       String   @default("09:30")
  officeEndTime         String   @default("18:00")
  graceMinutes          Int      @default(45)
  notifyTeams           Boolean  @default(true)
  notifyEmail           Boolean  @default(false)
  notificationsEnabled  Boolean  @default(true)
  alertIfNotInOffice    Boolean  @default(false)
  alertIfAgentStale     Boolean  @default(false)
  alertIfBehindHours    Boolean  @default(false)
  alertIfHoursStarted   Boolean  @default(true)
  alertIfHoursMet       Boolean  @default(true)
  channelNotInOffice    String   @default("app")
  channelAgentStale     String   @default("app")
  channelBehindHours    String   @default("app")
  channelHoursStarted   String   @default("teams")
  channelHoursMet       String   @default("teams")
  behindHoursCheckTime  String   @default("15:00")
  behindHoursMinExpected Float   @default(2.5)
  scheduleAutoFilled    Boolean  @default(false)
  scheduleUserSet       Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model InAppNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  dayKey    String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, type, dayKey])
  @@index([userId, readAt])
}

model AgentToken {
  id                String    @id @default(cuid())
  tokenHash         String
  tokenPrefix       String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String?
  boundSerialNumber String?
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  issuedById        String?
  pendingTokenEnc   String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  devices           AgentDevice[]

  @@index([userId])
}

model AgentDevice {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentTokenId String?
  agentToken   AgentToken? @relation(fields: [agentTokenId], references: [id], onDelete: SetNull)
  serialNumber String
  label        String?
  lastSeenAt   DateTime?
  installedAt  DateTime?
  uninstalledAt DateTime?
  agentScriptVersion String?
  agentVersionReportedAt DateTime?
  forceAgentUpdate Boolean @default(false)
  createdAt    DateTime    @default(now())
  removalRequests DeviceRemovalRequest[]
  lifecycleEvents AgentLifecycleEvent[]

  @@unique([userId, serialNumber])
}

model AgentLifecycleEvent {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       AgentDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  serialNumber String
  eventType    String
  source       String
  metadata     String?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@index([serialNumber, createdAt])
  @@index([eventType, createdAt])
}

model TimezoneChangeRequest {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedTimezone String
  currentTimezone   String
  message           String?
  status            String   @default("open")
  adminNote         String?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?    @relation("TimezoneRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model ProfileChangeRequest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentName    String?
  currentEmail   String
  requestedName  String?
  requestedEmail String?
  message        String?
  status         String   @default("open")
  adminNote      String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?    @relation("ProfileChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model DeviceRemovalRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  device       AgentDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  message      String?
  status       String      @default("open")
  adminNote    String?
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?       @relation("DeviceRemovalResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([deviceId])
}

model ComplianceExemptionRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  monthKey     String?
  dayKey       String?
  message      String?
  status       String   @default("open")
  adminNote    String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?    @relation("ComplianceExemptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([userId, monthKey])
  @@index([userId, dayKey])
}

model PriorComplianceDeclaration {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthKey             String
  typicalCheckInTime   String
  qualifyingDaysCount  Int
  message              String?
  status               String   @default("open")
  source               String   @default("onboarding")
  adminNote            String?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           User?    @relation("PriorComplianceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([userId, monthKey])
}

model AdminContactSubmission {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String
  message        String
  status         String   @default("open")
  adminResponse  String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?    @relation("AdminContactReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       AdminContactMessage[]

  @@index([status, createdAt])
  @@index([userId])
}

model AdminContactMessage {
  id         String                 @id @default(cuid())
  threadId   String
  thread     AdminContactSubmission @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorRole String
  body       String
  createdAt  DateTime               @default(now())

  @@index([threadId, createdAt])
}

model LegalConfig {
  id                  String    @id @default("global")
  legalVersion        Int       @default(1)
  termsContent        String    @default("[]")
  privacyContent      String    @default("[]")
  draftTermsContent   String?
  draftPrivacyContent String?
  draftChangeSummary  String?
  changeSummary       String?
  publishedAt         DateTime?
  publishedById       String?
  updatedAt           DateTime  @updatedAt
}

model AppConfig {
  id                String   @id @default("global")
  hoursTarget       Float    @default(5.0)
  monthlyDaysTarget Int      @default(8)
  officeSsids       String   @default("[\"OfficeConnect\",\"ExternalConnect\",\"pwcglb.com\"]")
  maxDevicesPerUser Int      @default(10)
  allowRegistration         Boolean  @default(false)
  allowOtpSelfRegistration  Boolean  @default(true)
  pendingTokenTtlDays   Int      @default(7)
  heartbeatRetentionDays Int     @default(1)
  agentStaleMinutes     Int      @default(8)
  agentStaleGraceHours  Int      @default(24)
  complianceExemptionRequiresApproval Boolean @default(true)
  pilotStartMonthKey    String   @default("2026-09")
  fiscalYearStartMonth  Int      @default(4)
  fiscalYearEndMonth    Int      @default(3)
  updatedAt             DateTime @updatedAt
}

model CronJobRun {
  id            String   @id @default(cuid())
  jobName       String
  source        String
  status        String
  startedAt     DateTime
  finishedAt    DateTime
  durationMs    Int
  resultSummary String?
  error         String?
  createdAt     DateTime @default(now())

  @@index([jobName, startedAt])
  @@index([status, startedAt])
}

model Heartbeat {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ssid       String?
  vpnGateway String?
  inOffice   Boolean
  source     String   @default("wifi")
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([userId, recordedAt])
}

model Visit {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime?
  source    String    @default("wifi")
  ssid      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  correctionRequests VisitCorrectionRequest[]

  @@index([userId, startAt])
}

model VisitCorrectionRequest {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitId           String?
  visit             Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  message           String
  issueType         String?
  status            String    @default("open")
  adminNote         String?
  visitSnapshot     String?
  correctionSummary String?
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        User?     @relation("VisitReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  messages          VisitCorrectionMessage[]

  @@index([status, createdAt])
  @@index([userId])
}

model VisitCorrectionMessage {
  id         String                 @id @default(cuid())
  requestId  String
  request    VisitCorrectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId   String
  author     User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorRole String
  body       String
  createdAt  DateTime               @default(now())

  @@index([requestId, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action       String
  targetUserId String?
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  details      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
