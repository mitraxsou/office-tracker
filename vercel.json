{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/agent-alerts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/purge-heartbeats",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/office-schedule",
      "schedule": "30 16 * * 0"
    }
  ]
}
